# TRACE Graph environment file. Copy to .env (never committed) — scripts/deploy.sh writes one
# per environment. Defaults below are the development environment.
TRACE_ENV=dev                 # dev | test | prod  (shown as a badge in the UI header)
PORT=8413                     # dev 8413 · test 8414 · prod 8415
TRACE_DB_PATH=data/trace.db   # SQLite file (git-ignored); relative to the repo root
TRACE_DATA_DIR=data           # root for claims/, versions/, runtime/ (tests point this at a tmpdir)
TRACE_ACCESS_KEY=change-me    # X-Access-Key required by every write endpoint
TAXONOMY_BASE_URL=http://localhost:8420   # MELIAF taxonomy service (optional; degrades gracefully)
OPENAI_API_KEY=               # optional — only /api/ask needs it; empty = 503 with a clear notice
TRACE_ASK_MODEL=gpt-5.5       # model used by /api/ask (falls back to gpt-4.1)
TRACE_PUBLIC_URL=https://p8413.synaptic.synapsis-analytics.com
